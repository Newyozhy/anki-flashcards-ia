# ==========================================
# AnkiCraft AI - Environment Configuration
# ==========================================

# Google Gemini API Key (Obtain free at https://aistudio.google.com)
GEMINI_API_KEY=

# Model configuration (Gemini 3.8 Flash is recommended)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
THINKING_BUDGET=1024

# AnkiConnect Configuration (Running in Anki Desktop on port 8765)
ANKI_CONNECT_URL=http://localhost:8765

# Server Port
HOST=127.0.0.1
PORT=8000
